# Host port of the app when run with docker compose (inside the container it is always 8000).
APP_PORT=8000

POSTGRES_DB=ecom_zwroty
POSTGRES_USER=ecom_zwroty
POSTGRES_PASSWORD=change-me
# Host port the DB is published on (127.0.0.1 only).
DB_PORT=5433

# For running on the host (uv run ...). docker compose builds the in-network URL from POSTGRES_* itself.
DATABASE_URL=postgresql://ecom_zwroty:change-me@localhost:5433/ecom_zwroty?sslmode=disable

JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=720

# Line photos. docker compose mounts ./uploads at /data/uploads.
UPLOADS_DIR=uploads
MAX_IMAGE_MB=15
MAX_IMAGES_PER_LINE=10

# WMS sheet (ORDER_ID → BO/WMS, CUSTOMER_ID → Tempo). Share the sheet with the service account's client_email.
GOOGLE_CREDENTIALS_FILE=creds.json
WMS_SHEET_ID=1h-tFVAE70lhn7H2xmD_KP_6qtE5yfCSfQ56anb-NewA
WMS_SHEET_GID=0
WMS_SYNC_ENABLED=true
WMS_SYNC_INTERVAL_MINUTES=60

# /api/integration/* accepts a logged-in user's token; this key is only for unattended jobs (header X-API-Key).
# Empty = key access disabled.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTEGRATION_API_KEY=
# Public origin used in photo links handed to scripts.
PUBLIC_BASE_URL=https://ecom-zwroty.piatek-magazyn.com
