PORT=8000

POSTGRES_DB=ecom_zwroty
POSTGRES_USER=ecom_zwroty
POSTGRES_PASSWORD=change-me
# Host port the DB is published on (127.0.0.1 only).
DB_PORT=5433

# App inside docker compose:
DATABASE_URL=postgresql://ecom_zwroty:change-me@db:5432/ecom_zwroty?sslmode=disable
# App on the host (uv run uvicorn ...): use this line instead.
# DATABASE_URL=postgresql://ecom_zwroty:change-me@localhost:5433/ecom_zwroty?sslmode=disable

JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=720

# Line photos. docker compose overrides the directory with a volume at /data/uploads.
UPLOADS_DIR=uploads
MAX_IMAGE_MB=15
MAX_IMAGES_PER_LINE=10

# WMS sheet (ORDER_ID → BO/WMS, CUSTOMER_ID → Tempo). Share the sheet with the service account's client_email.
GOOGLE_CREDENTIALS_FILE=creds.json
WMS_SHEET_ID=1h-tFVAE70lhn7H2xmD_KP_6qtE5yfCSfQ56anb-NewA
WMS_SHEET_GID=0
WMS_SYNC_ENABLED=true
WMS_SYNC_INTERVAL_MINUTES=60
